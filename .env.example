# Local app
APP_ENV=local
APP_NAME=Pramaan AI
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL (Docker Compose)
DATABASE_URL=postgresql+psycopg://pramaan:pramaan_local_only@127.0.0.1:5433/pramaan_dev

# Meta Model API: set the key privately; never commit .env
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
META_TIMEOUT_SECONDS=45
META_MAX_OUTPUT_TOKENS=500

# Instrumentation (optional for initial local setup)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Safety / demo bounds
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
MAX_AGENT_STEPS=3
MAX_MODEL_CALLS_PER_REQUEST=4
DAILY_MODEL_CALL_LIMIT=20

# Storage
DOCUMENT_STORAGE_DIR=../uploads

# OCR Configuration
OCR_LANGUAGES=eng+mal
OCR_DPI=300
OCR_MAX_PAGES_PER_REQUEST=20
TESSDATA_PREFIX=
