# Local app
APP_ENV=local
APP_NAME=Pramaan AI
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL (Docker Compose)
DATABASE_URL=postgresql+psycopg://pramaan:pramaan_local_only@127.0.0.1:5433/pramaan_dev

# Private durable document storage. Keep local for development; production requires gcs.
STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=../uploads
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
SUPABASE_STORAGE_BUCKET=pramaan-documents
# Backend only; never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Model API: set the key privately; never commit .env
MODEL_API_KEY=
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
META_TIMEOUT_SECONDS=45
META_MAX_OUTPUT_TOKENS=8000

# Langfuse LLM observability (metadata-only traces; inactive when keys are empty).
# Set LANGFUSE_ENABLED=false to run with tracing off even when keys are present.
# EU: https://cloud.langfuse.com — US: https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Safety / demo bounds
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=20
MAX_AGENT_STEPS=3
MAX_MODEL_CALLS_PER_REQUEST=4
# Installation-wide daily cap on outbound model calls (one budget per UTC day, shared by all
# workspaces). The per-request cap above is separate; exceeding either rejects the request
# before any model call is sent.
DAILY_MODEL_CALL_LIMIT=20

# Storage
DOCUMENT_STORAGE_DIR=../uploads

# OCR Configuration
OCR_LANGUAGES=eng+mal
OCR_DPI=300
OCR_MAX_PAGES_PER_REQUEST=20
TESSDATA_PREFIX=

# Vision & Provider Configuration (Milestone 3.1)
SCANNED_PAGE_EXTRACTOR=tesseract
META_VISION_FALLBACK_TO_TESSERACT=true
META_VISION_DPI=250
